{
  "name": "@billkul/core",
  "version": "0.1.0",
  "description": "Indian GST toolkit: GSTIN and PAN validation, CGST/SGST/IGST calculation, GST invoices (incl. export under LUT), amount in words in lakh/crore, UPI payment links and QR codes.",
  "keywords": [
    "gst",
    "gstin",
    "gst-calculator",
    "india",
    "indian",
    "invoice",
    "tax-invoice",
    "cgst",
    "sgst",
    "igst",
    "pan",
    "upi",
    "upi-qr",
    "amount-in-words",
    "number-to-words",
    "lakh",
    "crore",
    "inr",
    "rupee",
    "financial-year"
  ],
  "license": "MIT",
  "homepage": "https://github.com/naveensheejachacko/billKul/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naveensheejachacko/billKul.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/naveensheejachacko/billKul/issues"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/naveensheejachacko"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "billkul-source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
